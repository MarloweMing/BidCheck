# Copy this file to .env on the deployment host and replace every
# CHANGE_ME value with a different, randomly generated secret.
# Replace this with the deployment host's private-network address.
BIDCHECK_BIND_IP=CHANGE_ME_TO_SERVER_IP

BIDCHECK_MYSQL_USER=bidcheck_mysql
BIDCHECK_MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

BIDCHECK_RABBIT_USER=bidcheck_rabbit
BIDCHECK_RABBIT_PASSWORD=CHANGE_ME
BIDCHECK_RABBIT_VHOST=/bidcheck

BIDCHECK_MINIO_ROOT_USER=bidcheck_minio
BIDCHECK_MINIO_ROOT_PASSWORD=CHANGE_ME
