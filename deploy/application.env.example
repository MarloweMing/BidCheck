# Application process configuration for the single-VM profile.
# Replace CHANGE_ME values before use. Do not commit the completed file.
SPRING_PROFILES_ACTIVE=vm
BIDCHECK_ADDRESS=127.0.0.1
BIDCHECK_PORT=8787
BIDCHECK_DATA=./.local/vm-data

BIDCHECK_MYSQL_URL=jdbc:mysql://CHANGE_ME_TO_SERVER_IP:13306/bidcheck?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&sslMode=REQUIRED
BIDCHECK_MYSQL_USER=bidcheck_mysql
BIDCHECK_MYSQL_PASSWORD=CHANGE_ME

BIDCHECK_RABBIT_HOST=CHANGE_ME_TO_SERVER_IP
BIDCHECK_RABBIT_PORT=15673
BIDCHECK_RABBIT_USER=bidcheck_rabbit
BIDCHECK_RABBIT_PASSWORD=CHANGE_ME
BIDCHECK_RABBIT_VHOST=/bidcheck
BIDCHECK_RABBIT_ENABLED=true

BIDCHECK_STORAGE_TYPE=minio
BIDCHECK_STORAGE_ENDPOINT=http://CHANGE_ME_TO_SERVER_IP:19000
BIDCHECK_STORAGE_ACCESS_KEY=bidcheck_minio
BIDCHECK_STORAGE_SECRET_KEY=CHANGE_ME
BIDCHECK_STORAGE_BUCKET=bidcheck

# Optional model, retrieval, and OCR services. Leave disabled when unused.
BIDCHECK_MODEL_URL=
BIDCHECK_MODEL_KEY=
BIDCHECK_MODEL=
BIDCHECK_TEMPLATE_ROUTE_ENABLED=true
BIDCHECK_RETRIEVAL_ENABLED=false
BIDCHECK_OCR_ENABLED=false
BIDCHECK_PDF_OCR_ENABLED=false
BIDCHECK_VISUAL_ENABLED=false
